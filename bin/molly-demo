#!/usr/bin/env bash
# Molly zero-to-demo installer.
# Creates a fresh Laravel app, installs a tagged sifrious/molly release, runs molly:demo.
set -euo pipefail

MOLLY_CONSTRAINT="${MOLLY_CONSTRAINT:-^0.2}"

usage() {
  cat <<EOF
Usage: molly-demo [TARGET_DIR] [--force]

Creates a new Laravel project, commits it with your Git identity, installs
sifrious/molly (${MOLLY_CONSTRAINT}), and scaffolds demo-greeting with php artisan molly:demo.

Environment:
  MOLLY_CONSTRAINT   Stable release constraint (default: ^0.2)

Arguments:
  TARGET_DIR   Directory for the new app (default: ~/molly-demo)
  --force      Allow non-empty TARGET_DIR (deletes it first)
  -h, --help   Show this help

Requirements: PHP 8.3+, Composer, Git with user.name and user.email set. Prefers Packagist; falls back to public GitHub VCS tags.
EOF
}

TARGET=""
FORCE=0
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    --force) FORCE=1 ;;
    -*)
      echo "Unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$TARGET" ]]; then
        echo "Unexpected argument: $arg" >&2
        usage >&2
        exit 2
      fi
      TARGET=$arg
      ;;
  esac
done

TARGET=${TARGET:-"$HOME/molly-demo"}
TARGET=${TARGET/#\~/$HOME}

command -v php >/dev/null || { echo "PHP is required (8.3 or later)." >&2; exit 1; }
command -v composer >/dev/null || { echo "Composer is required." >&2; exit 1; }
command -v git >/dev/null || { echo "Git is required." >&2; exit 1; }
if [[ -z "$(git config user.email || true)" || -z "$(git config user.name || true)" ]]; then
  echo "Set your Git identity first: git config --global user.name \"Your Name\" and git config --global user.email you@example.com" >&2
  exit 1
fi

if [[ -e "$TARGET" ]]; then
  if [[ ! -d "$TARGET" ]]; then
    echo "Refusing: $TARGET exists and is not a directory." >&2
    exit 1
  fi
  if [[ -n "$(ls -A "$TARGET" 2>/dev/null || true)" ]]; then
    if [[ "$FORCE" -ne 1 ]]; then
      echo "Refusing: $TARGET exists and is not empty. Pass --force to replace it." >&2
      exit 1
    fi
  fi
fi

# Resolve in a disposable project before creating or replacing the target. Composer owns
# dependency resolution; a package listing or a successful HTTP request is not enough.
if [[ ! "$MOLLY_CONSTRAINT" =~ ^[0-9v\^\~\<\>\=\|\*\ ,.\-]+$ ]]; then
  echo "MOLLY_RELEASE_REQUIRED: Choose a stable release constraint. For unpublished candidates, follow docs/acceptance/README.md and install the checksummed artifact first." >&2
  exit 1
fi
PREFLIGHT=$(mktemp -d "${TMPDIR:-/tmp}/molly-release.XXXXXX")
trap 'rm -rf "$PREFLIGHT"' EXIT
printf '%s\n' '{"name":"molly/install-preflight","require":{},"minimum-stability":"stable"}' > "$PREFLIGHT/composer.json"
REPOSITORY=packagist
check_release() {
  COMPOSER=composer.json composer --working-dir="$PREFLIGHT" require --dev "sifrious/molly:${MOLLY_CONSTRAINT}@stable" \
    --dry-run --no-interaction --no-plugins --no-scripts --no-cache
}
echo "Checking Molly ${MOLLY_CONSTRAINT} before changing $TARGET …"
if ! check_release > "$PREFLIGHT/packagist.log" 2>&1; then
  REPOSITORY=github
  printf '%s\n' '{"name":"molly/install-preflight","require":{},"minimum-stability":"stable","repositories":[{"type":"vcs","url":"https://github.com/sifrious/molly"}]}' > "$PREFLIGHT/composer.json"
  if ! check_release > "$PREFLIGHT/github.log" 2>&1; then
    echo "MOLLY_RELEASE_UNAVAILABLE: Composer could not resolve sifrious/molly:${MOLLY_CONSTRAINT} from Packagist or public GitHub tags. Target left unchanged." >&2
    echo "Check repository access and compatible published tags, then retry. For unpublished candidate verification, follow docs/acceptance/README.md." >&2
    cat "$PREFLIGHT/packagist.log" "$PREFLIGHT/github.log" >&2
    exit 1
  fi
fi

if [[ -d "$TARGET" && "$FORCE" -eq 1 && -n "$(ls -A "$TARGET")" ]]; then
  echo "Removing existing non-empty $TARGET because --force was set …"
  rm -rf "$TARGET"
fi

echo "Creating Laravel app at $TARGET …"
composer create-project laravel/laravel "$TARGET" --no-interaction
cd "$TARGET"

# Molly records the commit each task starts from and never creates a repository itself.
# This installer created the app, so it commits it once with your own Git identity.
if [[ ! -e .git ]]; then
  echo "Committing the new app with your Git identity ($(git config user.email)) …"
  git init --quiet
  git add -A
  git commit -m "Start" --quiet
fi

echo "Installing Pest (Molly needs it) …"
composer config allow-plugins.pestphp/pest-plugin true
# Laravel 12 pins phpunit/phpunit ^11 in the app; Pest 4 needs PHPUnit 12.
if grep -q '"phpunit/phpunit"' composer.json; then
  composer remove --dev phpunit/phpunit --no-interaction
fi
composer require --dev pestphp/pest:^4 pestphp/pest-plugin-laravel:^4 --with-all-dependencies --no-interaction

echo "Installing Molly ${MOLLY_CONSTRAINT} …"
if [[ "$REPOSITORY" == "packagist" ]]; then
  echo "Using Packagist …"
else
  echo "Using the public GitHub tags checked during preflight …"
  composer config repositories.molly vcs https://github.com/sifrious/molly
fi
if ! composer require --dev "sifrious/molly:${MOLLY_CONSTRAINT}@stable" --no-interaction; then
  echo "MOLLY_INSTALL_FAILED: Preflight resolved the release, but installation failed. The Laravel app at $TARGET is incomplete; Molly setup did not finish. Check Composer's error before retrying." >&2
  exit 1
fi

echo "Publishing Molly config and migrating …"
php artisan vendor:publish --tag=molly-config --no-interaction
php artisan migrate --force --no-interaction

echo "Scaffolding demo-greeting …"
php artisan molly:demo --no-interaction

cat <<EOF

Molly is ready in:
  $TARGET

Standalone (no Bloom required):
1. cd "$TARGET"
2. Choose a local model. Preflight decides which approved model fits this Mac,
   and install-model asks before it downloads anything:
   php artisan molly:preflight
   php artisan molly:install-model
   php artisan molly:setup --agent=ollama --model=MODEL   (the name install-model prints)
3. Check setup:    php artisan molly:doctor
   Doctor reports whether this host can sandbox the writer and verifier.
   macOS usually cannot. Read the sandbox section of
   https://github.com/sifrious/molly/blob/main/docs/troubleshooting.md
4. Start the demo: php artisan molly:start demo-greeting

Optional Bloom workflow:
Open this project and branch in Bloom with "Open existing branch…", then export
a Molly Bloom contract using the workspace UUID, branch, and merge-base SHA that
Bloom shows:
  php artisan molly:bloom-contract demo-greeting --workspace-id=… --branch=… --base-sha=…
Molly does not create a Bloom worktree.

Installed constraint: ${MOLLY_CONSTRAINT}
No cloud was called. No Bloom install was added.
EOF
