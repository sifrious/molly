#!/usr/bin/env bash
# Molly zero-to-demo installer (MME-5294).
# Creates a fresh Laravel app, installs Molly, and runs molly:demo.
# Does not install Bloom, call cloud, or touch paths outside the target directory.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: molly-demo [TARGET_DIR] [--force]

Creates a new Laravel project, installs sifrious/molly, and scaffolds the
demo-greeting task with php artisan molly:demo.

Arguments:
  TARGET_DIR   Directory for the new app (default: ~/molly-demo)
  --force      Allow TARGET_DIR when it already exists and is not empty
  -h, --help   Show this help

Requirements: PHP 8.3+, Composer, network access to packagist and GitHub.
EOF
}

TARGET=""
FORCE=0
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --force)
      FORCE=1
      ;;
    -*)
      echo "Unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$TARGET" ]]; then
        echo "Unexpected argument: $arg" >&2
        usage >&2
        exit 2
      fi
      TARGET=$arg
      ;;
  esac
done

TARGET=${TARGET:-"$HOME/molly-demo"}
# Expand ~ if quoted oddly
TARGET=${TARGET/#\~/$HOME}

if ! command -v php >/dev/null 2>&1; then
  echo "PHP is required (8.3 or later)." >&2
  exit 1
fi
if ! command -v composer >/dev/null 2>&1; then
  echo "Composer is required." >&2
  exit 1
fi

if [[ -e "$TARGET" ]]; then
  if [[ ! -d "$TARGET" ]]; then
    echo "Refusing: $TARGET exists and is not a directory." >&2
    exit 1
  fi
  if [[ -n "$(ls -A "$TARGET" 2>/dev/null || true)" ]]; then
    if [[ "$FORCE" -ne 1 ]]; then
      echo "Refusing: $TARGET exists and is not empty. Pass --force to replace it (deletes that directory first)." >&2
      exit 1
    fi
    echo "Removing existing non-empty $TARGET because --force was set …"
    rm -rf "$TARGET"
  fi
fi

echo "Creating Laravel app at $TARGET …"
composer create-project laravel/laravel "$TARGET" --no-interaction

cd "$TARGET"

echo "Installing Pest 4 (Molly needs it) …"
composer config allow-plugins.pestphp/pest-plugin true
composer require --dev pestphp/pest:^4 pestphp/pest-plugin-laravel:^4 --with-all-dependencies --no-interaction

echo "Installing Molly from GitHub …"
composer config repositories.molly vcs https://github.com/sifrious/molly
composer require --dev sifrious/molly:dev-main --no-interaction

echo "Publishing Molly config and migrating …"
php artisan vendor:publish --tag=molly-config --no-interaction
php artisan migrate --force --no-interaction

echo "Scaffolding demo-greeting …"
php artisan molly:demo --no-interaction

cat <<EOF

Molly demo is ready in:
  $TARGET

Next steps (plain language):
1. Open this folder in Bloom with “Open existing branch…” (Molly does not create a Bloom worktree).
2. Check setup:  php artisan molly:doctor
3. Start the demo: php artisan molly:start demo-greeting
   Or print a Bloom contract after Bloom gives you workspace/branch/base-sha:
   php artisan molly:bloom-contract demo-greeting --workspace-id=… --branch=… --base-sha=…

No cloud was called. No Bloom install was added.
EOF
