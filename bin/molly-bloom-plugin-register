#!/usr/bin/env bash
# Install Molly's Bloom plugin: copy plugin.json and Surfaces.bundle into Bloom's plugin folder
# and add sifrious.molly to enabled.json. Safe to run again; each run replaces the installed copy.
#
# Environment:
#   BLOOM_APP          Bloom app bundle to check for (default: first of Bloom Dev.app, Bloom.app
#                      in ~/Applications and /Applications)
#   BLOOM_PLUGINS_DIR  Plugin root (default: ~/Library/Application Support/Bloom/Plugins)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PLUGIN_ID="sifrious.molly"
SRC_MANIFEST="$ROOT/bloom-plugin/plugin.json"
SRC_SURFACES="$ROOT/bloom-plugin/Surfaces.bundle"
PLUGINS_DIR="${BLOOM_PLUGINS_DIR:-$HOME/Library/Application Support/Bloom/Plugins}"
DEST_DIR="$PLUGINS_DIR/$PLUGIN_ID"
ENABLED="$PLUGINS_DIR/enabled.json"

fail() {
  echo "molly-bloom-plugin-register: $*" >&2
  exit 1
}

# dyld will not load a Mach-O that has no LC_UUID. otool -l prints that load
# command. dwarfdump --uuid prints the UUID when one is present.
molly_surfaces_has_lc_uuid() {
  local binary="$1"
  local checked=0
  if command -v otool >/dev/null 2>&1; then
    checked=1
    if otool -l "$binary" 2>/dev/null | grep -q 'LC_UUID'; then
      return 0
    fi
  fi
  if command -v dwarfdump >/dev/null 2>&1; then
    checked=1
    if dwarfdump --uuid "$binary" 2>/dev/null | grep -Eq '[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}'; then
      return 0
    fi
  fi
  if [[ "$checked" -eq 0 ]]; then
    fail "Could not check MollySurfaces for an LC_UUID load command. Neither otool nor dwarfdump is on PATH."
  fi
  return 1
}

if [[ -n "${BLOOM_APP:-}" ]]; then
  [[ -d "$BLOOM_APP" ]] || fail "BLOOM_APP is set to $BLOOM_APP, but no app exists there."
  APP="$BLOOM_APP"
else
  APP=""
  for candidate in "$HOME/Applications/Bloom Dev.app" "$HOME/Applications/Bloom.app" "/Applications/Bloom Dev.app" "/Applications/Bloom.app"; do
    if [[ -d "$candidate" ]]; then
      APP="$candidate"
      break
    fi
  done
  [[ -n "$APP" ]] || fail "Bloom is not installed. Looked for Bloom Dev.app and Bloom.app in ~/Applications and /Applications. Install Bloom, or set BLOOM_APP to its path, then run this again."
fi

[[ -f "$SRC_MANIFEST" ]] || fail "Missing $SRC_MANIFEST."
[[ -f "$SRC_SURFACES/Contents/Info.plist" && -f "$SRC_SURFACES/Contents/MacOS/MollySurfaces" ]] \
  || fail "Missing $SRC_SURFACES. Build it with bloom-plugin/Surfaces/build-bundle.sh first."

BINARY="$SRC_SURFACES/Contents/MacOS/MollySurfaces"
molly_surfaces_has_lc_uuid "$BINARY" \
  || fail "MollySurfaces has no LC_UUID load command, so dyld will not load it. Rebuild it with bloom-plugin/Surfaces/build-bundle.sh."
if ! strings "$BINARY" | grep -q 'molly:host-observe'; then
  fail "Surfaces.bundle does not contain molly:host-observe, so it was not built from these Swift sources. Rebuild it against Bloom 1599f05f: BLOOM_ROOT=/path/to/bloom ./bloom-plugin/Surfaces/build-bundle.sh"
fi
RECORDED_DIGEST="$(/usr/libexec/PlistBuddy -c 'Print :MollySourcesDigest' "$SRC_SURFACES/Contents/Info.plist" 2>/dev/null || true)"
if [[ -n "$RECORDED_DIGEST" ]]; then
  CURRENT_DIGEST="$(python3 - "$ROOT/bloom-plugin/Surfaces/Sources/MollySurfaces" <<'PY'
import hashlib, pathlib, sys
root = pathlib.Path(sys.argv[1])
digest = hashlib.sha256()
for path in sorted(p for p in root.rglob("*.swift") if p.is_file()):
    digest.update(path.relative_to(root).as_posix().encode())
    digest.update(b"\0")
    digest.update(path.read_bytes())
    digest.update(b"\0")
print(digest.hexdigest())
PY
)"
  if [[ "$RECORDED_DIGEST" != "$CURRENT_DIGEST" ]]; then
    fail "Surfaces.bundle MollySourcesDigest does not match the Swift sources. Rebuild it with bloom-plugin/Surfaces/build-bundle.sh and commit the bundle."
  fi
fi

BUILT_AGAINST="$(/usr/libexec/PlistBuddy -c 'Print :MollyBuiltAgainstBloomCommit' "$SRC_SURFACES/Contents/Info.plist" 2>/dev/null || echo "not recorded")"
HOST_COMMIT="$(/usr/libexec/PlistBuddy -c 'Print :BloomMasterCommit' "$APP/Contents/Info.plist" 2>/dev/null || echo "not recorded")"

echo "Bloom app:            $APP"
echo "Bloom host commit:    $HOST_COMMIT"
echo "Bundle built against: $BUILT_AGAINST"
if [[ "$HOST_COMMIT" != "not recorded" && "$BUILT_AGAINST" != "not recorded" && "$HOST_COMMIT" != "$BUILT_AGAINST"* && "$BUILT_AGAINST" != "$HOST_COMMIT"* ]]; then
  echo "Note: the bundle was built against a different Bloom commit. It loads only if that Bloom exports the same BloomPluginAPI symbols."
fi

mkdir -p "$DEST_DIR"
cp "$SRC_MANIFEST" "$DEST_DIR/plugin.json"
echo "Copied plugin.json to $DEST_DIR/plugin.json"
rm -rf "$DEST_DIR/Surfaces.bundle"
cp -R "$SRC_SURFACES" "$DEST_DIR/Surfaces.bundle"
echo "Copied Surfaces.bundle to $DEST_DIR/Surfaces.bundle"

PLUGIN_ID="$PLUGIN_ID" ENABLED_PATH="$ENABLED" python3 - <<'PY'
import json, os, pathlib, sys
path = pathlib.Path(os.environ["ENABLED_PATH"])
plugin_id = os.environ["PLUGIN_ID"]
ids = []
if path.exists():
    try:
        ids = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        sys.exit(f"molly-bloom-plugin-register: {path} is not valid JSON ({error}). Fix or remove it, then run this again.")
    if not isinstance(ids, list):
        sys.exit(f"molly-bloom-plugin-register: {path} must be a JSON array of plugin ids.")
if plugin_id in ids:
    print(f"{plugin_id} was already listed in {path}")
else:
    ids.append(plugin_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(sorted(set(ids)), indent=2) + "\n")
    print(f"Added {plugin_id} to {path}")
PY

SHA="$(shasum -a 256 "$DEST_DIR/Surfaces.bundle/Contents/MacOS/MollySurfaces" | awk '{print $1}')"
VERSION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$DEST_DIR/plugin.json")"
echo "Installed Molly plugin $VERSION (MollySurfaces sha256 $SHA)."
echo "Quit and reopen Bloom to load it. Bloom reads plugins once at launch."
