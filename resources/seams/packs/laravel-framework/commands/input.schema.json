{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "symbol",
    "path",
    "target_state",
    "test_path",
    "production_paths",
    "accepted_state",
    "fixtures",
    "cases",
    "negative_control"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "path": {
      "type": "string",
      "pattern": "^(app|routes)/[A-Za-z0-9_/-]+\\.php$"
    },
    "target_state": {
      "enum": [
        "existing",
        "planned"
      ]
    },
    "test_path": {
      "type": "string",
      "pattern": "^tests/Feature/[A-Za-z0-9_/-]+Test\\.php$"
    },
    "production_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(app|routes|resources)/[A-Za-z0-9_./-]+$"
      }
    },
    "accepted_state": {
      "type": "object",
      "additionalProperties": false
    },
    "fixtures": {
      "type": "array",
      "maxItems": 0
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "command",
          "arguments",
          "expected",
          "before"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "command": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9:_-]+$",
            "maxLength": 100
          },
          "arguments": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean",
                "array"
              ]
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exit",
              "output"
            ],
            "properties": {
              "exit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exit",
              "output"
            ],
            "properties": {
              "exit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "output": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "negative_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "find",
        "replace",
        "case_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "find": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "replace": {
          "type": "string",
          "maxLength": 1000
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      }
    },
    "verification_path": {
      "type": "string",
      "enum": [
        "baseline_red",
        "already_implemented"
      ],
      "description": "Choose already_implemented explicitly when intake should be GREEN. No historical RED is claimed."
    }
  }
}
