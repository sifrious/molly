{
  "version": "2026-09-17",
  "steps": [
    {
      "id": "outcome",
      "title": "Describe the outcome",
      "question": "What must the user be able to do, and what is outside this task?",
      "help": "Describe an observable result and one concrete example. Separate the requirement from a preferred implementation.",
      "source_ids": [
        "mary-tarpit",
        "laravel-testing"
      ]
    },
    {
      "id": "state",
      "title": "Identify essential data",
      "question": "Which facts must survive the request, and which values can be computed?",
      "help": "Name the records, ownership, and allowed state changes. Explain any duplicated or cached value that the requirement needs.",
      "source_ids": [
        "mary-tarpit",
        "laravel-eloquent",
        "laravel-validation"
      ]
    },
    {
      "id": "laravel",
      "title": "Use existing Laravel behavior",
      "question": "Which existing application code and Laravel facilities already handle this work?",
      "help": "Check routing, validation, Eloquent, container resolution, events, and queues before adding another mechanism. For a native target, consult the matching NativePHP track and installed version.",
      "source_ids": [
        "mary-tarpit",
        "laravel-routing",
        "laravel-validation",
        "laravel-eloquent",
        "laravel-container",
        "laravel-events",
        "laravel-queues",
        "nativephp-desktop",
        "nativephp-mobile"
      ]
    },
    {
      "id": "boundaries",
      "title": "Justify each boundary",
      "question": "What concrete requirement needs a new interface, layer, package, or native integration?",
      "help": "Describe the caller and the behavior that must vary. Prefer existing framework resolution when sufficient. Keep the simplest direct implementation when no current requirement needs another boundary.",
      "source_ids": [
        "mary-tarpit",
        "laravel-container",
        "nativephp-desktop",
        "nativephp-mobile"
      ]
    },
    {
      "id": "verification",
      "title": "Define passing evidence",
      "question": "Which acceptance tests and Tarpit findings will show that the requirement is met?",
      "help": "Specify successful behavior, important failure cases, and any complexity that remains necessary. Keep test results and complexity review separate; explain each unresolved finding.",
      "source_ids": [
        "mary-tarpit",
        "laravel-testing",
        "laravel-events"
      ]
    }
  ],
